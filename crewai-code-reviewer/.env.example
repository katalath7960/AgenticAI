# ==============================================
# CrewAI Code Review Agent – Environment Config
# ==============================================
# Copy this file to .env and fill in your values.

# ── LLM Provider (choose one) ──────────────────
# OpenAI (default)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_NAME=gpt-4o

# Anthropic (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Azure OpenAI (alternative)
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Ollama (local, free)
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL_NAME=llama3

# ── GitHub Integration (optional) ──────────────
GITHUB_TOKEN=ghp_your-github-token-here

# ── Azure DevOps Integration ──────────────────
# Required for review_ado_pr.py
# Create a PAT at: https://dev.azure.com/{org}/_usersSettings/tokens
# Minimum scope: Code (Read & Write)
AZURE_DEVOPS_ORG='stellarus'
AZURE_DEVOPS_PROJECT='FJD'
AZURE_DEVOPS_PAT='>REMOVED_AZURE_PAT'
