# Copy this file to .env and fill in your values
# Load with: export $(cat .env | xargs)

# ── Gmail SMTP (100% free, 500 emails/day) ──────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Go to myaccount.google.com → Security → App Passwords
# Step 3: Create an App Password for "Mail" — it gives you a 16-char code
GMAIL_SENDER=damushreya@gmail.com
GMAIL_APP_PASSWORD=lqxyffxaeasibdel   # 16-char App Password (spaces OK)

# ── Your alert destination (can be same Gmail or any other email) ────────────
ALERT_EMAIL=damushreya@gmail.com
