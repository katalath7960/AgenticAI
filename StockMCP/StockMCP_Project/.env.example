# StockMCP — Email Alert Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to: Google Account → Security → App Passwords
# 3. Generate a 16-character app password for "Mail"
# 4. Paste it below (spaces in the password are fine — they are stripped automatically)

GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Recipient for alerts (defaults to GMAIL_SENDER if left blank)
ALERT_EMAIL=your-email@gmail.com
